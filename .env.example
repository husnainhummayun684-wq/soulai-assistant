# ClickUp personal API token (ClickUp > Settings > Apps > API Token)
# Used by free MIT MCP: @misddev/clickup-mcp-server (no paid license key)
# After editing, reload MCP in Cursor (Settings → MCP → refresh/restart).
CLICKUP_API_KEY=pk_xxx
# ClickUp workspace/team ID (first number in URL: app.clickup.com/TEAM_ID/...)
CLICKUP_TEAM_ID=xxxxxxx

# Notion: project MCP uses the official remote server (https://mcp.notion.com/mcp)
# with OAuth in Cursor — no API key required. Enable "notion" under Settings → MCP
# and complete the OAuth flow.

# Meta Graph API — Instagram + Facebook

# --- Single account ---
# One Page + linked IG. account_id is optional in tools when only this is set.
# META_PAGE_ACCESS_TOKEN=
# META_PAGE_ID=
# META_IG_BUSINESS_ACCOUNT_ID=

# --- Multi-account ---

# META_ACCOUNTS=[
#         {
#             "id":"soulplus",
#             "label":"SoulPlus AI",
#             "page_id":"PAGE_ID",
#             "page_access_token":"EAAB...",
#             "ig_business_account_id":"IG_ID"
#         },
#         {
#             "id":"maria-lit",
#             "label":"Maria Lit",
