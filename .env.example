# Notion internal integration token (Settings & members > Connections > Develop or manage integrations)
# Copy this file to `.env` and replace the value. Never commit `.env`.
#
# Token access is NOT controlled from this repo. In Notion, open the integration → Capabilities
# and enable (recommended for this assistant):
#   - Read content
#   - Update content
#   - Insert content
#   - Read user information including email addresses (optional; for assignees/mentions)
# Then Share each product doc (or parent page) with this integration — otherwise search returns 0 pages.
#
# @notionhq/notion-mcp-server authenticates via NOTION_TOKEN.
# `.cursor/run-mcp.mjs` copies NOTION_API_KEY → NOTION_TOKEN, so set only one value here.
NOTION_API_KEY=secret_xxx

# ClickUp personal API token (ClickUp > Settings > Apps > API Token)
# Used by free MIT MCP: @misddev/clickup-mcp-server (no paid license key)
# Loaded by `.cursor/run-mcp.mjs` from this file (do not rely on system env vars).
# After editing, reload MCP in Cursor (Settings → MCP → refresh/restart).
CLICKUP_API_KEY=pk_xxx
# ClickUp workspace/team ID (first number in URL: app.clickup.com/TEAM_ID/...)
CLICKUP_TEAM_ID=xxxxxxx
